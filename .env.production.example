# RecoverAI Production Environment Variables Template
# DO NOT commit actual secrets or production keys into version control.

# Deployment Environment
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=change_this_to_a_secure_random_64_character_string_in_production

# PostgreSQL Database Configuration
POSTGRES_USER=recoverai_prod_user
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=recoverai_prod_db
DATABASE_URL=postgresql+asyncpg://recoverai_prod_user:change_this_postgres_password@postgres:5432/recoverai_prod_db

# Redis Cache & Celery Broker
REDIS_URL=redis://redis:6379/0

# Razorpay API Credentials (Track 03 AI Revenue Recovery)
RAZORPAY_KEY_ID=rzp_live_CHANGE_THIS_KEY_ID
RAZORPAY_KEY_SECRET=CHANGE_THIS_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_THIS_WEBHOOK_SECRET

# Groq LLM Service API Key
GROQ_API_KEY=gsk_CHANGE_THIS_GROQ_API_KEY

# System Mode Boundary: REAL_TEST vs SIMULATION
RECOVERAI_MODE=REAL_TEST
